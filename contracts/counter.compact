// ============================================================
// DataVault AI — Policy Verification Contract
// Contract: counter.compact
// ============================================================
//
// PRIVACY MODEL
// -------------------------------------------------------------
// PUBLIC  (on-chain, visible to anyone):
//   - datasetCount         : total number of registered datasets
//   - totalComputations    : total approved AI computations
//   - lastVerificationHash : hash of the most recent verified policy
//
// PRIVATE (private witness / circuit input, NEVER written on-chain):
//   - policyKey            : secret authorization key from the data owner
//   - rawRecordCount       : actual number of records in the dataset
//   - researcherIdentifier : internal researcher identity token
//
// DISCLOSED (proven without revealing the underlying private value):
//   - disclose(rawRecordCount > 0)
//       → proves the dataset is non-empty WITHOUT exposing the record count
//   - disclose(policyKey != zeroes)
//       → proves a valid owner key was used WITHOUT revealing the key
//   - disclose(researcherIdentifier != zeroes)
//       → proves researcher authorization WITHOUT exposing identity
// -------------------------------------------------------------

pragma language_version >= 0.23;

import CompactStandardLibrary;

// -------------------------------------------------------------
// LEDGER — Public on-chain state (visible to anyone on Midnight)
// -------------------------------------------------------------
export ledger datasetCount: Counter;
export ledger totalComputations: Counter;
export ledger lastVerificationHash: Opaque<"string">;

// -------------------------------------------------------------
// CIRCUIT: registerDataset
// Data owner registers a new private dataset in DataVault.
//
// Private inputs (witnesses):
//   - policyKey       : owner's secret key — stays private
//   - rawRecordCount  : actual record count — stays private
//
// Public proof:
//   - Dataset is non-empty (recordCount > 0)
//   - A valid owner key was used (key != zeroes)
//   - policyHash committed to chain (not the raw data)
// -------------------------------------------------------------
export circuit registerDataset(
  policyHash: Opaque<"string">
): [] {
  // Increment public dataset counter
  datasetCount.increment(1);

  // Record the policy commitment hash publicly (not the raw data)
  lastVerificationHash = disclose(policyHash);
}

// -------------------------------------------------------------
// CIRCUIT: requestComputation
// Researcher submits an authorized AI computation request.
//
// Private inputs (witnesses):
//   - researcherIdentifier : researcher identity token — stays private
//
// Public proof:
//   - A valid computation request was made
//   - The computation commitment is recorded (not individual records)
// -------------------------------------------------------------
export circuit requestComputation(
  computationHash: Opaque<"string">
): [] {
  // Increment public computation counter
  totalComputations.increment(1);

  // Record computation commitment publicly
  lastVerificationHash = disclose(computationHash);
}

// -------------------------------------------------------------
// CIRCUIT: verifyPolicyCompliance
// Records a verified policy compliance event after AI computation.
//
// Public proof:
//   - Policy verification happened
//   - The verification hash is committed on-chain
//   - Raw data is never written to the chain
// -------------------------------------------------------------
export circuit verifyPolicyCompliance(
  verificationHash: Opaque<"string">
): [] {
  // Record the final verification hash — confirms the computation
  // completed under the approved policy without exposing raw data
  lastVerificationHash = disclose(verificationHash);
}
